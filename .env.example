# Enable dev-only routes (/_dev/ui). Never set to true in production.
NEXT_PUBLIC_ENABLE_DEV_ROUTES=false

# Public app origin — must be the canonical production URL in prod (e.g. https://app.sszplatform.com).
# Used by scheduling/enrollment BFF Server Actions to call local Route Handlers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Backend integration ──────────────────────────────────────────────────────
# Option A: route all services through a single API Gateway / nginx.
# API_GATEWAY_URL=http://localhost:80

# Option B: point directly at each service.
# Per-service URLs take precedence over API_GATEWAY_URL — useful in local dev
# when a service is not yet registered in nginx.
# AUTH_SERVICE_URL=http://localhost:5001
# PROFILE_SERVICE_URL=http://localhost:5002
# CONTENT_SERVICE_URL=http://localhost:5003
# EXERCISE_SERVICE_URL=http://localhost:5004
# PROGRESS_SERVICE_URL=http://localhost:5005
# ENROLLMENT_SERVICE_URL=http://localhost:5006
# MEDIA_SERVICE_URL=http://localhost:5007
# ORGANIZATION_SERVICE_URL=http://localhost:3002
# SCHEDULING_SERVICE_URL=http://localhost:3009
# ANALYTICS_SERVICE_URL=http://localhost:3010
# NOTIFICATION_SERVICE_URL=http://localhost:3011

# ── Internal service-to-service calls ─────────────────────────────────────────
# content-service's `/internal/*` routes are gated by InternalAuthGuard and are
# deliberately NOT exposed through the API gateway/nginx — the BFF must reach
# content-service directly for these (used by the publish pre-flight route).
# CONTENT_SERVICE_INTERNAL_URL=http://localhost:3003
# exercise-engine's `/internal/*` routes are gated the same way, and hold the teacher
# side of an attempt — the review queue the exercise editor opens.
# EXERCISE_SERVICE_INTERNAL_URL=http://localhost:3006
# ORGANIZATION_SERVICE_INTERNAL_URL=http://localhost:3002
# analytics-service holds the mastery profile (plan 55) behind the same guard: what a
# learner is weak at is said about a named person, so it never reaches the public gateway.
# ANALYTICS_SERVICE_INTERNAL_URL=http://localhost:3008
# Must match content-service's INTERNAL_SERVICE_TOKEN (see infrastructure/docker-compose.dev.yml).
# INTERNAL_SERVICE_TOKEN=internal-dev-token

# ── API versioning ────────────────────────────────────────────────────────────
# Path prefix prepended to every upstream serverFetch request (default: /api/v1).
# Change only if the backend uses a different version prefix.
# UPSTREAM_API_PREFIX=/api/v1

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign/verify auth cookies (min 32 chars).
AUTH_COOKIE_SECRET=change-me-to-a-random-32-char-secret

# ── Tuning ────────────────────────────────────────────────────────────────────
# Timeout for upstream requests in milliseconds (default: 15000).
# UPSTREAM_TIMEOUT_MS=15000

# Log BFF → upstream requests and responses to the server console (default: false).
# LOG_UPSTREAM_REQUESTS=true

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry DSN — obtain from your Sentry project settings.
# NEXT_PUBLIC_SENTRY_DSN exposes the DSN to the browser (client-side errors).
# SENTRY_DSN is the server-only counterpart; if both are set, SENTRY_DSN is preferred on the server.
# Leave blank to disable Sentry (safe for local dev — no events will be sent).
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYY
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYY

# Sentry source-map upload (CI only — set these in your CI environment, not in .env.local).
# SENTRY_AUTH_TOKEN=sntrys_xxx   # from Project Settings → Auth Tokens
# SENTRY_ORG=your-sentry-org     # Sentry organisation slug
# SENTRY_PROJECT=ssz-platform-web  # Sentry project slug

# ── Feature flags ─────────────────────────────────────────────────────────────
# Show the in-app notification bell (requires NOTIFICATION_SERVICE_URL). Disabled by default.
# NEXT_PUBLIC_FEATURE_NOTIFICATIONS=false

# Teacher self-declared availability editor. Keep disabled until
# scheduling-service ships availability CRUD endpoints (plan-28 §2.1).
# NEXT_PUBLIC_FEATURE_TEACHER_AVAILABILITY=false

# ── Locale defaults (code-driven, no env var needed) ──────────────────────────
# Default locale resolution: Norway (NO) → nb, Ukraine (UA) → uk,
# everywhere else → en. Override: Accept-Language header or user preference.
# Supported locales: en (English), nb (Norsk), uk (Українська), ru (Русский).
# No NEXT_PUBLIC_DEFAULT_LOCALE env var — see src/lib/i18n/request.ts.
