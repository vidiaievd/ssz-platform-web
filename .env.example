# Enable dev-only routes (/_dev/ui). Never set to true in production.
NEXT_PUBLIC_ENABLE_DEV_ROUTES=false

# Public app origin — used by Server Actions to call local BFF routes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Backend integration ──────────────────────────────────────────────────────
# Option A: route all services through a single API Gateway / nginx.
# API_GATEWAY_URL=http://localhost:80

# Option B: point directly at each service.
# Per-service URLs take precedence over API_GATEWAY_URL — useful in local dev
# when a service is not yet registered in nginx.
# AUTH_SERVICE_URL=http://localhost:5001
# PROFILE_SERVICE_URL=http://localhost:5002
# CONTENT_SERVICE_URL=http://localhost:5003
# EXERCISE_SERVICE_URL=http://localhost:5004
# PROGRESS_SERVICE_URL=http://localhost:5005
# ENROLLMENT_SERVICE_URL=http://localhost:5006
# MEDIA_SERVICE_URL=http://localhost:5007
# ORGANIZATION_SERVICE_URL=http://localhost:3002
# SCHEDULING_SERVICE_URL=http://localhost:3009
# ANALYTICS_SERVICE_URL=http://localhost:3010
# NOTIFICATION_SERVICE_URL=http://localhost:3011

# ── API versioning ────────────────────────────────────────────────────────────
# Path prefix prepended to every upstream serverFetch request (default: /api/v1).
# Change only if the backend uses a different version prefix.
# UPSTREAM_API_PREFIX=/api/v1

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign/verify auth cookies (min 32 chars).
AUTH_COOKIE_SECRET=change-me-to-a-random-32-char-secret

# ── Tuning ────────────────────────────────────────────────────────────────────
# Timeout for upstream requests in milliseconds (default: 15000).
# UPSTREAM_TIMEOUT_MS=15000

# Log BFF → upstream requests and responses to the server console (default: false).
# LOG_UPSTREAM_REQUESTS=true

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry DSN — obtain from your Sentry project settings.
# NEXT_PUBLIC_SENTRY_DSN exposes the DSN to the browser (source-map uploads, client errors).
# SENTRY_DSN is the server-only fallback; if both are set SENTRY_DSN is preferred on the server.
# Leave blank to disable Sentry (no errors reported in local dev by default).
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYY
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYY
# SENTRY_AUTH_TOKEN=sntrys_xxx  # required for source-map uploads during `next build`

# ── Feature flags ─────────────────────────────────────────────────────────────
# Show the in-app notification bell (requires NOTIFICATION_SERVICE_URL). Disabled by default.
# NEXT_PUBLIC_FEATURE_NOTIFICATIONS=false

# Teacher self-declared availability editor. Keep disabled until
# scheduling-service ships availability CRUD endpoints (plan-28 §2.1).
# NEXT_PUBLIC_FEATURE_TEACHER_AVAILABILITY=false
